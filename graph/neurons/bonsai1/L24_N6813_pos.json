 "label_history": [
  [
   "2026-10-21-moridinamael-5f42b8a8",
   "In English instructions or advice addressed to the reader, offering YOU an optional or alternative way to do something ('or you can...', 'you can also...', 'if you prefer, you could...'), strongest on 'can/could', the verb after it or the 'and' joining a second step. The same actions told as past-tense narrative stay low, as do passive or third-person options ('it can be...', 'applicants may...') and other languages; a camelCase code key piece can leak.",
   "failed"
  ],
  [
   "2026-11-02-moridinamael-339b2e5b",
   "In practical how-to text (web forms, documents, medicines), the 'and' / 'and then' that adds a second step after a first action, and that second step's verb (e.g. 'register online and then print'); any person or tense. Plain 'you can also...' offers and single-step instructions stay low.",
   "failed"
  ],
  [
   "2026-11-02-moridinamael-b69dd217",
   "In step-by-step instructions addressed to the reader (web forms, documents, medicines), the 'and' / 'and then' that chains a second action after a first, and that next step's verb (e.g. 'register online and then print'); the same chain told as a story or past-tense narration stays low.",
   "failed"
  ],
  [
   "2026-11-02-moridinamael-1c9cee75",
   "The verb 'print' (or 'download') as the next step after 'and then' in a procedure, in instructions or story; other next-step verbs fire weaker",
   "failed"
  ]
 ],
